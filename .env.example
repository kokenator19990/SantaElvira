# ─── Supabase / Postgres ──────────────────────────────────────────────────────
# Obtener estas credenciales en:
#   Supabase Dashboard → Project Settings → Database
#   Supabase Dashboard → Project Settings → API

# Connection string POOLED (Transaction mode, puerto 6543)
# Para queries en runtime serverless (Vercel functions, RSC).
# Formato: postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.xxx:PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres"

# Connection string DIRECTO (puerto 5432)
# Solo se usa para migraciones con drizzle-kit (no para runtime).
# Formato: postgresql://postgres:<password>@db.<project_ref>.supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres"

# Cliente Supabase JS (auth, storage, realtime — uso futuro)
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# ─── Autenticacion Admin ─────────────────────────────────────────────────────
# Credenciales para el login del panel de administracion.
# Sin estas variables el login mostrara un error de configuracion.
ADMIN_USER="msg"
ADMIN_PASSWORD="cambiar-este-password"

# Secret para firmar los tokens de sesion con HMAC-SHA256.
# REQUERIDO. Sin este valor el login falla con error de configuracion.
# Generar con: openssl rand -hex 32
ADMIN_JWT_SECRET="generar-un-secret-aleatorio-aqui"

# Salt opcional para el hashing PBKDF2 del password.
# Si no se define, usa una constante interna (aceptable para este caso de uso).
# Generar con: openssl rand -hex 16
# ADMIN_SALT="generar-un-salt-opcional-aqui"

# ─── Cron / Seguridad ────────────────────────────────────────────────────────
# Secret compartido con Vercel Cron para autenticar el endpoint /api/digest.
# INDEPENDIENTE del ADMIN_JWT_SECRET — rotar uno no afecta al otro.
# Generar con: openssl rand -hex 32
CRON_SECRET="generar-un-secret-aleatorio-aqui"

# ─── Email Digest (opcional) ─────────────────────────────────────────────────
# Si se configuran, el endpoint /api/digest envia un email diario con el resumen.
# Sin estas variables, el digest retorna HTML para preview sin enviar email.
# RESEND_API_KEY="re_..."
# DIGEST_TO="gerente@msg.com,supervisor@msg.com"
# DIGEST_FROM="MSG Dashboard <noreply@resend.dev>"
